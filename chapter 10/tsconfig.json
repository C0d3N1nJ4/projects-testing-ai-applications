{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "types": ["node", "@playwright/test"],
    "skipLibCheck": true,
    "outDir": "dist",
    "noEmit": true
  },
  "include": ["src", "tests", "playwright.config.ts", "playwright.learning.config.ts"]
}
